# Dedicated Under Construction Mini PC backend
PORT=4001
DEVICE_ID=underconstruction-esp32

# ESP32 static IP & authentication key
ESP32_URL=http://192.168.1.85
DEVICE_KEY=REPLACE_WITH_A_UNIQUE_LONG_RANDOM_SECRET

# Database
DB_PATH=underconstruction_model.db
DEVICE_TIMEOUT_MS=15000
ESP32_TIMEOUT_MS=4000

# ThingsBoard Integration (same as Cement Plant)
THINGSBOARD_HOST=allcad-chennai.selfip.com
THINGSBOARD_URL=http://allcad-chennai.selfip.com:8081
THINGSBOARD_USERNAME=tenant@thingsboard.org
THINGSBOARD_PASSWORD=tenant
THINGSBOARD_TOKEN=underconstruction-esp32

# MQTT Broker (Optional - Mosquitto)
MQTT_HOST=host.docker.internal
MQTT_PORT=1883
MQTT_PREFIX=plant/crane
